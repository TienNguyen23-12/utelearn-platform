#!/bin/sh

set -e

ROOT_DIR="$(git rev-parse --show-toplevel)"
if [ -d "$ROOT_DIR/utelearn" ]; then
    APP_DIR="$ROOT_DIR/utelearn"
else
    APP_DIR="$ROOT_DIR"
fi

cd "$APP_DIR" || exit 1

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

if git diff --cached | grep -E '^\+[<]{7}|^\+[=]{7}|^\+[>]{7}' > /dev/null 2>&1; then
    echo "================================================================================"
    echo "[ERROR] Unresolved merge conflict markers detected in staged files."
    echo "[ERROR] Please resolve all <<<<<<< / ======= markers before committing."
    echo "================================================================================"
    exit 1
fi

JAVA_CHANGES=$(echo "$STAGED_FILES" | grep -E '\.java$' || true)

if [ -n "$JAVA_CHANGES" ]; then
    echo "[pre-commit] Verifying Java syntax & compilation..."
    if ! ./mvnw test-compile -DskipTests -B -q; then
        echo "--------------------------------------------------------------------------------"
        echo "[ERROR] Java compilation failed. Fix syntax or type errors before committing."
        echo "--------------------------------------------------------------------------------"
        exit 1
    fi
fi

echo "[pre-commit] [OK] Quality gates passed."
exit 0
